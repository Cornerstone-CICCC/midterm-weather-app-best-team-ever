---
import "../styles/global.scss";

import Search from "../components/Search.astro";
import Favorites from "../components/Favorites.astro";
import CurrentWeather from "../components/CurrentWeather.astro";
import DailyForecast from "../components/DailyForecast.astro";
import HourlyForecast from "../components/HourlyForecast.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Weather App</title>
  </head>

  <body>
    <div class="site-background">
      <video
        id="backgroundVideo"
        autoplay
        muted
        loop
        playsinline
      ></video>

      <div class="site-background__overlay"></div>
    </div>

    <main class="app">
      <section class="weather-container">
        <header class="page-header">
          <div class="page-header-left">
            <p class="greeting-text">
              <span class="greeting-base">Good daytime</span>
              <span class="greeting-punctuation">.</span>
              <span class="greeting-name"></span>
            </p>
          </div>

          <div class="header-actions">
            <button type="button" class="nav-button open-auth-login">Log in</button>
            <span class="nav-separator">|</span>
            <button type="button" class="nav-button open-auth-register">Sign in</button>
            <button type="button" class="menu-button" aria-label="User settings">☰</button>
          </div>
        </header>

        <div id="authModal" class="auth-modal hidden" aria-hidden="true">
          <div class="auth-modal-backdrop" data-close></div>
          <div class="auth-modal-content">
            <div class="auth-tabs">
              <button type="button" class="auth-tab active" data-auth-mode="login">Log in</button>
              <button type="button" class="auth-tab" data-auth-mode="register">Register</button>
            </div>

            <div id="loginPanel" class="auth-panel auth-panel--active">
              <h2>Welcome back</h2>
              <p>Sign in to continue with your account.</p>
              <form id="loginForm" class="auth-form">
                <label>
                  Username
                  <input type="text" name="username" placeholder="Enter username" required />
                </label>
                <label>
                  Password
                  <input type="password" name="password" placeholder="Enter password" required />
                </label>
                <button type="submit" class="auth-submit">Log in</button>
                <div class="auth-alternative">
                  <button type="button" class="auth-secondary auth-google-button" data-provider="google">Continue with Google</button>
                  <button type="button" class="auth-secondary">Continue with Email</button>
                </div>
                <p class="auth-switch">
                  Don't have an account?
                  <button type="button" class="auth-link" data-switch="register">Register</button>
                </p>
              </form>
            </div>

            <div id="registerPanel" class="auth-panel">
              <h2>Create account</h2>
              <p>Register with your details and join the experience.</p>
              <form id="registerForm" class="auth-form">
                <label>
                  Username
                  <input type="text" name="username" placeholder="Choose username" required />
                </label>
                <label>
                  Email
                  <input type="email" name="email" placeholder="you@example.com" required />
                </label>
                <label>
                  Password
                  <input type="password" name="password" placeholder="Create password" required />
                </label>
                <label>
                  Confirm password
                  <input type="password" name="confirmPassword" placeholder="Confirm password" required />
                </label>
                <label class="auth-checkbox">
                  <input type="checkbox" name="notifications" />
                  Receive notifications from this page
                </label>
                <button type="submit" class="auth-submit">Sign up</button>
                <p class="auth-switch">
                  Already have an account?
                  <button type="button" class="auth-link" data-switch="login">Log in</button>
                </p>
              </form>
            </div>
            <div class="auth-scroll-indicator" aria-hidden="true"></div>
          </div>
        </div>

        <div class="top-row">
          <Search />
          <Favorites />
        </div>

        <section class="weather-hero">
          <CurrentWeather />
        </section>

        <DailyForecast />

        <HourlyForecast />
      </section>
    </main>

    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
