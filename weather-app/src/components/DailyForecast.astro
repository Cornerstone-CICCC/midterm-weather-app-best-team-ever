---
---

<section class="forecast-panel">
  <header class="forecast-header forecast-header--daily">
    <div class="forecast-title">
      <span class="forecast-title__icon">🗓️</span>

      <div>
        <h2>5-Day Daily Forecast</h2>
        <p>Detailed weather overview for the next 5 days</p>
      </div>
    </div>

    <div class="forecast-actions">
      <button type="button" aria-label="Previous days">‹</button>
      <button type="button" aria-label="Next days">›</button>
    </div>
  </header>

  <div id="dailyForecast" class="daily-grid"></div>

  <div class="forecast-legend">
    <div class="forecast-legend__item">
      <span class="forecast-legend__icon">💨</span>
      <div>
        <strong>Wind</strong>
        <span>Shows the current wind speed and direction</span>
      </div>
    </div>

    <div class="forecast-legend__item">
      <span class="forecast-legend__icon">💧</span>
      <div>
        <strong>Humidity</strong>
        <span>Amount of moisture in the air</span>
      </div>
    </div>

    <div class="forecast-legend__item">
      <span class="forecast-legend__icon">🍃</span>
      <div>
        <strong>Air Quality</strong>
        <span>Air quality index (AQI)</span>
      </div>
    </div>

    <div class="forecast-legend__item">
      <span class="forecast-legend__icon">☀️</span>
      <div>
        <strong>UV Index</strong>
        <span>UV radiation level from the sun</span>
      </div>
    </div>

    <div class="forecast-legend__item">
      <span class="forecast-legend__icon">👁️</span>
      <div>
        <strong>Visibility</strong>
        <span>How far you can see horizontally</span>
      </div>
    </div>
  </div>

  <p class="forecast-tip">
    ⓘ Tip: Click on any day to view the 3-hour forecast for that day
  </p>
</section>